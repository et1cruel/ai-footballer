# Optional: local SQLite (default: api/data/football.sqlite)
FOOTBALL_DB_PATH=api/data/football.sqlite
# Generate your own long random string; never place in web/config.js
FOOTBALL_ADMIN_TOKEN=
# Server-only key for the live match feed and in-play analysis.
API_FOOTBALL_KEY=
# In deployment replace with your website origin e.g. https://football-ai.pages.dev
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Future server-side Supabase integration (not necessary for local MVP)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
